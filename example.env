# Скопируйте в .env (файл в .gitignore) и заполните. Читают демо (bootRun) и ./gradlew :ads-eval:eval.
# Ключ авторизации из личного кабинета GigaChat API: Base64 от client_id:client_secret.
GIGACHAT_CREDENTIALS=
# GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B / GIGACHAT_API_CORP — юрлица.
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Корневой сертификат Минцифры (https://gu-st.ru/content/Other/doc/russian_trusted_root_ca.cer).
# Путь абсолютный: демо и прогон golden set запускаются из разных каталогов.
GIGACHAT_CA_CERTS=/path/to/russian_trusted_root_ca.cer
