{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ads-demo",
      "runtimeExecutable": "./gradlew",
      "runtimeArgs": [
        ":ads-demo:bootRun"
      ],
      "port": 8080
    },
    {
      "name": "ads-demo-hashing-embeddings",
      "runtimeExecutable": "./gradlew",
      "runtimeArgs": [
        ":ads-demo:bootRun",
        "--args=--ads.llm.embedding.provider=hashing"
      ],
      "port": 8080
    }
  ]
}
